{
  "_comment": "Example batch configuration for CIMFlow. Download models first: ./run_example.sh --download",
  "output_dir": "../output/examples",
  "keep_ir": false,
  "run_name": "example_run",
  "runs": [
    {
      "_comment": "ResNet-18 with default parameters",
      "model_path": "../data/models/resnet18.onnx",
      "t": 8,
      "k": 16,
      "b": 16,
      "c": 64,
      "batch_size": 1,
      "strategy": "dp"
    },
    {
      "_comment": "MobileNetV2 with default parameters",
      "model_path": "../data/models/mobilenetv2.onnx",
      "t": 8,
      "k": 16,
      "b": 16,
      "c": 64,
      "batch_size": 1,
      "strategy": "dp"
    }
  ]
}
